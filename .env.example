# Copy this file to .env (or set these as real environment variables) and fill in your own values.
# Never commit the real .env file — it's already covered by .gitignore.

# Database
MYSQL_URL=jdbc:mysql://localhost:3306/blood_bank_finder?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQLUSER=root
MYSQLPASSWORD=root

# REST API admin protection (X-ADMIN-TOKEN header on /api/admin/** endpoints)
ADMIN_TOKEN=change-me-to-a-long-random-value

# Web dashboard admin login (seeded automatically on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# Donor eligibility window
DONATION_GAP_DAYS=90

# Server port (Railway sets this automatically in production)
PORT=8080
